# Safe-by-default template for the isolated staging environment.
# Copy to cloudflare/wrangler.toml only after confirming the staging D1 ID.
# Do NOT replace this with the production database ID or deploy to production.

name = "storyforge-staging"
main = "worker.js"
compatibility_date = "2026-11-22"
workers_dev = true

[assets]
directory = "../public"
binding = "ASSETS"
run_worker_first = ["/api/*", "/auth/*"]

[[d1_databases]]
binding = "DB"
database_name = "storyforge-staging"
database_id = "REPLACE_WITH_STAGING_D1_DATABASE_ID"
migrations_dir = "migrations"
